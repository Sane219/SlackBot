# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Secrets — never commit. The LLM API key, Slack xoxc token and xoxd cookie
# live in the OS keychain, not in files. These patterns are a second line of
# defence in case a key ever lands on disk by accident.
.env
.env.*
!.env.example
*.pem
*.key

# Local data
*.db
*.db-shm
*.db-wal
/slackbot-data/

# Impeccable working artifacts. config.json is committed (it records the build path);
# build output, review captures and mocks are local.
.impeccable/build/
.impeccable/review/
.impeccable/mocks/
.impeccable/config.local.json

# macOS
.DS_Store
# Node. Only `ui/node_modules` — `dist/` IS committed (ADR-0009), because the Rust
# binary embeds it and `cargo run` must not need Node.
ui/node_modules/
